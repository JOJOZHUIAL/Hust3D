# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）
# 生产环境建议直接用系统环境变量注入

# —— 安全密钥（务必改成随机字符串） ——
SECRET_KEY=please-change-me
JWT_SECRET=please-change-me
# 登录态有效期（秒），默认 7 天
JWT_EXPIRES=604800

# —— 数据库 ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hust_3d

# —— 教务系统（jwzx.hrbust.edu.cn，Acegi 登录 + 图形验证码） ——
# 本地开发：1=不连学校系统；接入真实教务系统后改 0
CAS_MOCK=1
CAS_BASE_URL=http://jwzx.hrbust.edu.cn
CAS_HOMEPAGE_URL=/homepage/index.do
CAS_CAPTCHA_URL=/academic/getCaptcha.do
CAS_LOGIN_URL=/academic/j_acegi_security_check
# 登录成功后抓取姓名/学院的页面地址（学籍信息页）
CAS_INFO_URL=/academic/accessModule.do?moduleId=2060&groupId=
# 调试：1=登录后把学籍页字段结构写入 _cas_debug.txt（定位字段用，默认关）
CAS_DEBUG=0

# —— 业务 ——
# 每学期默认打印次数
DEFAULT_QUOTA=2
# 管理员学号清单（逗号分隔）
ADMIN_STUDENT_IDS=20260001

# —— 站点 ——
# 前端地址（用于部署 / CORS 等场景）
FRONTEND_URL=https://your-domain.com
