# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）
# 生产环境建议直接用系统环境变量注入

# —— 安全密钥（务必改成随机字符串） ——
SECRET_KEY=please-change-me
JWT_SECRET=please-change-me
# 登录态有效期（秒），默认 7 天
JWT_EXPIRES=604800

# —— 数据库 ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hust_3d

# —— 教务系统（jwzx.hrbust.edu.cn，Acegi 登录 + 图形验证码） ——
# 本地开发：1=不连学校系统；接入真实教务系统后改 0
CAS_MOCK=1
CAS_BASE_URL=http://jwzx.hrbust.edu.cn
CAS_HOMEPAGE_URL=/homepage/index.do
CAS_CAPTCHA_URL=/academic/getCaptcha.do
CAS_LOGIN_URL=/academic/j_acegi_security_check
# 登录成功后抓取姓名/学院的页面地址（学籍信息页）
CAS_INFO_URL=/academic/accessModule.do?moduleId=2060&groupId=
# 调试：1=登录后把学籍页字段结构写入 _cas_debug.txt（定位字段用，默认关）
CAS_DEBUG=0

# —— 业务 ——
# 每学期默认打印次数
DEFAULT_QUOTA=2
# 反馈奖励模式：auto=上传成功自动+1；review=管理员审核通过后+1
FEEDBACK_REWARD_MODE=auto
# 已过期的申请补交反馈时是否仍发奖励：0=不发放（默认，只记录不奖励）；1=发放
FEEDBACK_REWARD_EXPIRED=0

# —— 邮件通知（打印完成后自动发邮件提醒领取；不配置则不发） ——
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=xxx@qq.com
# SMTP_PASS=授权码（不是登录密码）
# SMTP_SENDER=xxx@qq.com
# 反馈有效期（天）：打印完成后多少天内未反馈即标记「已过期」；0=关闭
# 改完重启后端会自动按新天数重新判定历史数据（放宽会撤销过期标记，收紧会补标）
FEEDBACK_EXPIRE_DAYS=7
# 打印机进度自动完成：1=开启（绑定打印机后进度到 100% 自动标记完成）
PRINT_WATCH_ENABLED=1
# 监视轮询间隔（秒）
PRINT_WATCH_INTERVAL=5

# —— 短信通知（打印完成后发短信通知申请人取件）——
# 由一台装了「短信转发器 / SmsForwarder」的手机代发：服务器给它发 HTTP 请求，它发短信
SMS_ENABLED=0

# 短信网关地址模板：{phone} 手机号、{msg} 短信正文、{token} 访问令牌 都会被 URL 编码后填入
# 例：SmsForwarder 开启「主动控制 / HttpServer」后，把它显示的示例地址改成这个格式：
#   SMS_GATEWAY_URL=http://192.168.1.50:8080/send_sms?token={token}&phone={phone}&msg={msg}
SMS_GATEWAY_URL=
# —— 多监听窗口 ——
# 可以配置多台手机/多个地址，按顺序挑第一个可用的发；都不通就进队列等重试。
# 写法一：SMS_GATEWAY_URL_2 ~ SMS_GATEWAY_URL_9 各写一条
#   SMS_GATEWAY_URL_2=http://192.168.1.130:5000/sms/send
# 写法二：在同一个变量里用换行或分号分隔多条
#   SMS_GATEWAY_URL=http://192.168.1.129:5000/sms/send;http://192.168.1.130:5000/sms/send
# 请求方式 GET / POST（参数仍写在 URL 模板里）
SMS_GATEWAY_METHOD=GET
# 通道类型：template=URL 参数模板（上面的写法）；json=POST JSON 报文（SmsForwarder 主动控制用这个）
SMS_PROVIDER=template
# json 通道的报文模板，占位符 {phone} {msg} {token} 会自动做 JSON 转义
# SmsForwarder「主动控制」的实际报文（字段名来自其源码 server/model/SmsSendData.kt）：
#   {"data":{"sim_slot":1,"phone_numbers":"{phone}","msg_content":"{msg}"}}
#   sim_slot：1=SIM1，2=SIM2（必须与实际有卡的卡槽一致，填 0 会数组越界把请求挂死）
SMS_JSON_TEMPLATE={"data":{"sim_slot":1,"phone_numbers":"{phone}","msg_content":"{msg}"}}
# 网关访问令牌（App 里设置的那个 token）
SMS_GATEWAY_TOKEN=
# 请求超时（秒）
SMS_GATEWAY_TIMEOUT=8
# 短信正文模板，可用占位符 {name} {apply_no} {file_name}
SMS_TEMPLATE=【3D打印服务】{name}同学，您的打印件（{apply_no}）已打印完成，请携带校园卡到3D打印工作室领取。
# 待发短信队列的重试间隔（秒）：手机网关不在线时短信先存库，到点自动补发；0=关闭
SMS_RETRY_INTERVAL=60
# 管理员学号清单（逗号分隔）
# 注意：在管理后台「管理员管理」里添加/移除管理员时，后端会自动把学号写入/移出这一行，
#      一般不需要手工维护；手工改完需重启服务生效。
ADMIN_STUDENT_IDS=20260001
# 超级管理员学号（可添加/移除管理员，逗号分隔）
SUPER_ADMIN_STUDENT_IDS=2504060306

# —— 站点 ——
# 前端地址（用于部署 / CORS 等场景）
FRONTEND_URL=https://your-domain.com

# —— 公共管理员（工作室共用账号）——
# 权限等同普通管理员；但审批 / 开始打印 / 拆封耗材时必须填写实际操作人学号
PUBLIC_ADMIN_USERNAME=admin
PUBLIC_ADMIN_PASSWORD=hust3d123456

# —— sms-hub 短信网关（ESP32C3 + 4G 模组，推荐；SMS_PROVIDER=smshub 时生效）——
# 发短信走 POST {base}/api/send（先 POST /api/login 取令牌），不是 /hook/*
SMSHUB_BASE_URL=http://192.168.1.150:8025
SMSHUB_USER=admin
SMSHUB_PASSWORD=请改成sms-hub的WEBUI_PASS
# 留空则自动挑「已绑定在线设备」的 SIM 卡；多卡时可显式指定 sim_id
SMSHUB_SIM_ID=
SMSHUB_TIMEOUT=10
# 网络抖动时的重试次数（1s/2s/4s 退避）
SMSHUB_RETRIES=3

# —— 内嵌 sms-hub（单进程托管，不再单独起 8025 服务）——
# 1=由 run_server.py 用 uvicorn 同时托管 Flask 与 sms-hub；0=维持独立 8025 进程
SMSHUB_EMBEDDED=1
# 固件 /hook/{token} 用的令牌（= 原 sms-hub 的 DEVICE_TOKEN）
SMSHUB_DEVICE_TOKEN=hust3d123456
# 兼容端口：只服务 /hook/*，让未刷固件的 ESP32 继续工作；0=关闭
SMSHUB_LEGACY_PORT=8025
# 数据目录（短信库 + JWT 密钥），留空 → backend/instance/smshub
SMSHUB_DATA_DIR=

# —— 原生短信模块 ——
# 收到新短信时 POST 到这个地址（留空=不转发）
NATIVE_SMS_WEBHOOK=
# 转发轮询间隔（秒），0=关闭
NATIVE_SMS_FORWARD_INTERVAL=20

# —— 自动通知开关（管理端「消息通知 → 设置」可切换）——
NOTIFY_AUTO_SMS=1
NOTIFY_AUTO_EMAIL=1

# —— 通知模板（管理端可编辑；文件里换行写成字面量 \n）——
# 占位符：{name} {apply_no} {file_name} {printer} {deadline}
NOTIFY_SMS_TEMPLATE=
NOTIFY_EMAIL_SUBJECT=
NOTIFY_EMAIL_TEMPLATE=
